# Browser-visible default; also needs to be included in GOTENBERG_ALLOWED_URLS.
VITE_GOTENBERG_DEFAULT_URL=https://demo.gotenberg.dev

# Maximum uploaded file bytes checked by the browser at build time.
# Keep this below GOTENUI_MAX_REQUEST_BYTES to allow multipart/JSON overhead.
VITE_GOTENUI_MAX_UPLOAD_BYTES=4000000

# Comma-separated approved Gotenberg base URLs, including optional path prefixes.
# The default (when unset) is https://demo.gotenberg.dev only.
# Local Docker example: https://demo.gotenberg.dev,http://gotenberg:3000
GOTENBERG_ALLOWED_URLS=https://demo.gotenberg.dev

# Combined maximum inbound multipart body size (bytes).
# 4,200,000 is suitable for Vercel's 4.5 MB function request limit.
GOTENUI_MAX_REQUEST_BYTES=4200000

# Max response stream size from Gotenberg (bytes); defaults to 100 MB.
# Streaming enforces this even if Content-Length is absent or incorrect.
# Increase for large PDFs up to a maximum of 500,000,000 bytes.
GOTENUI_MAX_RESPONSE_BYTES=100000000

# Optional public browser origin when a TLS-terminating reverse proxy changes
# the scheme/host Nitro sees in Request.url (e.g. internal HTTP listener).
# Must be a single HTTP(S) origin, without any path, query, or credentials.
# Unset by default: the proxy compares Origin against Request.url directly.
# GOTENUI_PUBLIC_ORIGIN=https://documents.example.com

# Optional upstream Basic Auth (server-only). All three variables must be configured
# together, and the URL must exactly match one entry in GOTENBERG_ALLOWED_URLS.
# DO NOT use the VITE_ prefix or store these credentials in browser localStorage.
# GOTENBERG_BASIC_AUTH_URL=https://pdf.internal.example.com
# GOTENBERG_BASIC_AUTH_USERNAME=replace-with-username
# GOTENBERG_BASIC_AUTH_PASSWORD=replace-with-strong-password

# Optional named server-managed connections (server-only JSON, NOT prefixed VITE_).
# Each URL must be present in GOTENBERG_ALLOWED_URLS.
# Set authentication per profile, using {"type":"basic","username":"...","password":"..."}
# or {"type":"bearer","token":"..."}. Without auth, omit that field.
# GOTENUI_SERVER_CONNECTIONS=[{"id":"production","name":"Production","url":"https://pdf.example.com","auth":{"type":"basic","username":"service","password":"secret"}}]

# UI visibility only. Defaults to true when omitted. Values must be true or false.
# These flags hide buttons; they DO NOT block the matching proxy API endpoints.
# GOTENUI_SHOW_DEBUG=false
# GOTENUI_SHOW_METRICS=false

# Legacy GOTENUI_PROFILE_ACCESS_KEY and GOTENUI_DEBUG_ACCESS_KEY are no longer used.
# Gotenberg itself must enforce access to conversions, /debug, and /prometheus/metrics.
# Enable API_ENABLE_DEBUG_ROUTE=true on the Gotenberg instance to use debug.
# Legacy Prometheus: /prometheus/metrics is deprecated; prefer OpenTelemetry.
# IMPORTANT: A server-managed connection with preconfigured Basic/Bearer credentials
# makes those credentials available as a capability to ANY caller of this Gotenui proxy.
# Deploy behind a trusted identity-aware proxy or use user-supplied browser credentials
# when access to the UI is public. Hiding buttons is not an access control.
