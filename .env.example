# Browser settings are embedded at build time.
# Rebuild the app after changing either PUBLIC_ value.
PUBLIC_GOTENBERG_DEFAULT_URL=https://demo.gotenberg.dev
PUBLIC_GOTENUI_MAX_UPLOAD_BYTES=4000000

# Approved upstream Gotenberg URLs. Comma-separated for multiple instances.
GOTENBERG_ALLOWED_URLS=https://demo.gotenberg.dev

# Optional site-wide Basic Auth. Set both variables at runtime to enable it.
# GOTENUI_BASIC_AUTH_USERNAME=admin
# GOTENUI_BASIC_AUTH_PASSWORD=replace-with-a-strong-password

# Maximum request and streamed response sizes in bytes.
GOTENUI_MAX_REQUEST_BYTES=4200000
GOTENUI_MAX_RESPONSE_BYTES=100000000

# Set if a TLS-terminating proxy changes the origin Nitro sees.
# GOTENUI_PUBLIC_ORIGIN=https://documents.example.com

# Optional authentication for one allowlisted Gotenberg instance.
# GOTENBERG_BASIC_AUTH_URL=https://pdf.example.com
# GOTENBERG_BASIC_AUTH_USERNAME=service
# GOTENBERG_BASIC_AUTH_PASSWORD=replace-with-a-secret

# Optional named managed connections. Basic, bearer and OAuth2 auth are supported.
# GOTENUI_SERVER_CONNECTIONS=[{"id":"main","name":"Main","url":"https://pdf.example.com","auth":{"type":"basic","username":"service","password":"secret"}}]

# UI visibility only. These flags do not block API endpoints.
# GOTENUI_SHOW_DEBUG=false
# GOTENUI_SHOW_METRICS=false
