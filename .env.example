# Browser-visible default; also needs to be included in GOTENBERG_ALLOWED_URLS.
VITE_GOTENBERG_DEFAULT_URL=https://demo.gotenberg.dev

# Maximum uploaded file bytes checked by the browser at build time.
# Keep this below GOTENUI_MAX_REQUEST_BYTES to allow multipart/JSON overhead.
VITE_GOTENUI_MAX_UPLOAD_BYTES=4000000

# Comma-separated approved Gotenberg base URLs, including optional path prefixes.
# The default (when unset) is https://demo.gotenberg.dev only.
# Local Docker example: https://demo.gotenberg.dev,http://gotenberg:3000
GOTENBERG_ALLOWED_URLS=https://demo.gotenberg.dev

# Combined maximum inbound multipart body size (bytes).
# 4,200,000 is suitable for Vercel's 4.5 MB function request limit.
GOTENUI_MAX_REQUEST_BYTES=4200000

# Optional upstream Basic Auth (server-only). All three variables must be configured
# together, and the URL must exactly match one entry in GOTENBERG_ALLOWED_URLS.
# DO NOT use the VITE_ prefix or store these credentials in browser localStorage.
# GOTENBERG_BASIC_AUTH_URL=https://pdf.internal.example.com
# GOTENBERG_BASIC_AUTH_USERNAME=replace-with-username
# GOTENBERG_BASIC_AUTH_PASSWORD=replace-with-strong-password
